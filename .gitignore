# ---- Data: far too big for Git -------------------------------------------
# Raw CSV (1.3 GB) and the full Parquet file are never committed.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# The 100k-row sample (a few MB) IS committed on purpose, so group members can
# work on notebooks without downloading the full dataset. To stop committing
# it, uncomment the next two lines.
# data/sample/*
# !data/sample/.gitkeep

# Safety net: never commit any CSV or Parquet file outside data/sample
*.csv
!results/tables/*.csv
!results/logs/*.csv
*.parquet
!data/sample/*.parquet

# ---- Python / Jupyter ----------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ---- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- LaTeX build files (report/) ------------------------------------------
report/*.aux
report/*.log
report/*.out
report/*.synctex.gz
report/*.fls
report/*.fdb_latexmk
