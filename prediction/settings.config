[paths]
flights = data/processed/flights_2024_clean.parquet
routes = results/tables/rq1_route_clusters_jan_jun.csv
airports = results/tables/03_airports.csv
output = results/rq3_pipeline_v2

[experiment]
seed = 42
train_size = 200000
evaluation_size = 100000
importance_size = 10000
importance_repeats = 3
prior_delay_rate = 0.20
validation_months = 7,8
test_months = 9,10,11,12
threshold_min = 0.05
threshold_max = 0.60
threshold_steps = 56
min_validation_specificity = 0.50
train_windows = 0,2,4

[models]
ebm_interactions = 0,3
ebm_learning_rate = 0.03
logistic_c = 0.1,1.0
xgb_depth = 3,5
xgb_estimators = 150
workers = 4
